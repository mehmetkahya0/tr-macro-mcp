# Copy to .env (git-ignored) and fill in what you need. Everything is optional.

# Free key from https://evds3.tcmb.gov.tr (log in -> Profile -> "Copy API Key").
# Without it the server runs in keyless mode (TCMB exchange rates only).
EVDS_API_KEY=

# Where the DuckDB cache lives. Default: the OS user cache dir.
# TR_MACRO_CACHE_DIR=

# Seconds between two requests to the same host (politeness). Default 1.0.
# TR_MACRO_MIN_REQUEST_INTERVAL=1.0

# HTTP timeout in seconds. Default 30.
# TR_MACRO_HTTP_TIMEOUT=30
